#!/bin/bash

function print_help() {
  echo -e "Usage:"
  echo -e "  $0 [options]"
  echo -e ""
  echo -e "Options:"
  echo -e "  -h, --help             : Display this help and exit"
  echo -e "  -m, --media-device     : Media device node (default: /dev/media0)"
  echo -e "  -f, --format <fmt>     : Valid values for <fmt>: color or mono"
  echo -e "  -r, --framerate <rate> : Valid values for <rate> : 60 or 120"
}

# Set default mode to mono at 60fps
fmt="mono"
media="/dev/media0"
fps="60"

while [ "$1" != "" ]; do
  case $1 in
  -h | --help )
    print_help $0
    exit 0
    ;;
  -m | --media-device )
    shift
    media=$1
    ;;
  -f | --format )
    shift
    fmt=$1
    ;;
  -r | --framerate )
    shift
    fps=$1
    ;;
  * )
    echo -e "invalid argument '$1'\n"
    print_help $0
    exit 1
    ;;
  esac
  shift
done

# check media node exists
if [ ! -e ${media} ]; then
  echo "Requested media node ${media} does not exist."
  exit 1
fi

# check mode is valid
if [ "${fmt}" = "mono" ]; then
  echo "Configure pipeline for imx547 monochrome sensor"
  fmt1="Y10_1X10"
  fmt2="Y8_1X8"
  fmt3="Y8_1X8"
elif [ "${fmt}" = "color" ]; then
  echo "Configure pipeline for imx547 color sensor"
  fmt1="SRGGB10_1X10"
  fmt2="SRGGB8_1X8"
  fmt3="RBG888_1X24"
else
  echo "Invalid format ${fmt}. Supported formats are: color or mono"
  exit 1
fi

# set framerate
if [ "${fps}" = "60" ]; then
  echo "Configure framerate as ${fps}fps for imx547 sensor"
elif [ "${fps}" = "120" ]; then
  echo "Configure framerate as ${fps}fps for imx547 sensor"
else
  echo "Invalid framerate ${fps}. Supported rates are: 60 or 120"
  exit 1
fi

# Configure the sensor subdev node
# Even though we are requesting 1920x1080, the sensor driver hard-codes the
# resolution to 2472x2128. There is a crop and a fixed resize IP in the capture
# pipeline that crops 64 pixel lines of optical black and down-sizes the image
# to 1920x1080.
media-ctl -d ${media} -V "\"imx547 7-001a\":0 [fmt:${fmt1}/2472x2064 field:none @1/${fps}]"
media-ctl -d ${media} -V "\"axi:isp_subset_convertor_0\":0 [${fmt1}/2472x2064 field:none]"
media-ctl -d ${media} -V "\"axi:isp_subset_convertor_0\":1 [${fmt2}/2472x2064 field:none]"
media-ctl -d ${media} -V "\"b0000000.ISPPipeline_accel\":0 [${fmt2}/2472x2064 field:none]"
media-ctl -d ${media} -V "\"b0000000.ISPPipeline_accel\":1 [${fmt3}/1920x1080 field:none]"

# Wait for previous command to complete
echo $?

# Print the media graph to check device topology & its formats
echo "Check the media graph for 1920x1080p & formats"
echo "\n"
media-ctl -d ${media} -p

# Tune the sensor parameters for better image quality
echo "Run v4l2 commands to tune the sensor parameters for better image quality"
echo "\n"
if [ "${fmt}" = "mono" ]; then
  v4l2-ctl -d /dev/video0 -c black_level=50
  v4l2-ctl -d /dev/video0 -c exposure=400
  v4l2-ctl -d /dev/video0 -c gain=250
elif [ "${fmt}" = "color" ]; then
  v4l2-ctl -d /dev/video0 -c black_level=50
  v4l2-ctl -d /dev/video0 -c exposure=5000
  v4l2-ctl -d /dev/video0 -c gain=300
fi
v4l2-ctl -d /dev/video0 -l

# Wait for previous command to complete
echo $?

# Configure PPi-Video IP
/bin/busybox devmem 0xa0030000 32 0x9A8
/bin/busybox devmem 0xa0030004 32 0x850

# Configure SLVS-EC IP Core
/bin/busybox devmem 0xa0020000 32 0xa
/bin/busybox devmem 0xa002000c 32 0x1

# Wait for previous command to complete
echo $?
